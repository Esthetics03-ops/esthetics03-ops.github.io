    <style>
      :root {
        --bg: #07121d;
        --bg-soft: #0d1a2b;
        --panel: rgba(15, 23, 42, 0.78);
        --panel-border: rgba(255, 255, 255, 0.12);
        --text: #ebf2ff;
        --muted: #a9bfd7;
        --gold: #d9b56d;
        --green: #68d391;
        --shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top, rgba(59, 130, 246, 0.15), transparent 28%),
          linear-gradient(180deg, var(--bg) 0%, #0c1728 100%);
        color: var(--text);
        line-height: 1.6;
      }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }
      .container {
        width: min(1100px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .topbar {
        border-bottom: 1px solid var(--panel-border);
        background: rgba(7, 18, 29, 0.8);
        backdrop-filter: blur(10px);
      }

      .topbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 0.7rem 0;
        font-size: 0.82rem;
        color: var(--muted);
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
      }

      .brand-mark {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--gold), #f8e6b0);
        color: var(--bg);
        display: grid;
        place-items: center;
        font-weight: 800;
      }

      .nav {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        flex-wrap: wrap;
      }

      .nav a {
        color: var(--muted);
        transition: color 0.22s ease;
      }

      .nav a:hover, .nav a:focus-visible {
        color: var(--text);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        border-radius: 999px;
        padding: 0.9rem 1.5rem;
        border: 1px solid transparent;
        font-weight: 700;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .btn:hover, .btn:focus-visible {
        transform: translateY(-1px);
      }

      .btn-primary {
        background: linear-gradient(135deg, var(--gold), #f3d98c);
        color: #111827;
      }

      .btn-secondary {
        background: rgba(255,255,255,0.04);
        border-color: var(--panel-border);
        color: var(--text);
      }

      header.hero {
        padding: 4.5rem 0 2rem;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.15fr 0.85fr;
        gap: 2rem;
        align-items: center;
      }

      .eyebrow {
        display: inline-block;
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(217, 181, 109, 0.12);
        color: var(--gold);
        border: 1px solid rgba(217, 181, 109, 0.2);
        font-size: 0.85rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      h1 {
        margin: 1rem 0 1rem;
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: 0.98;
        letter-spacing: -0.05em;
      }

      .hero-copy p {
        max-width: 62ch;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 1.5rem;
      }

      .stats {
        margin-top: 1.8rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 0.8rem;
      }

      .stats-card {
        background: rgba(255,255,255,0.025);
        border: 1px solid var(--panel-border);
        border-radius: 18px;
        padding: 1rem;
      }

      .stats-card strong {
        display: block;
        font-size: 1.4rem;
      }

      .stats-card span {
        color: var(--muted);
        font-size: 0.82rem;
      }

      .panel {
        background: linear-gradient(180deg, rgba(15,25,38,0.96), rgba(15,23,42,0.82));
        border: 1px solid var(--panel-border);
        border-radius: 28px;
        padding: 1.2rem;
        box-shadow: var(--shadow);
      }

      .mini-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--panel-border);
        border-radius: 18px;
        padding: 1rem;
      }

      .hero-visual {
        position: relative;
        padding: 1rem;
      }

      .visual-box {
        min-height: 430px;
        border-radius: 24px;
        background:
          linear-gradient(160deg, rgba(14, 116, 144, 0.9), rgba(17, 24, 39, 0.8)),
          url('/logo.png') center/cover no-repeat;
        border: 1px solid var(--panel-border);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: end;
      }

      .visual-box::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent, rgba(8, 15, 25, 0.85));
      }

      .visual-content {
        position: relative;
        z-index: 1;
        padding: 1.2rem;
        width: 100%;
      }

      section {
        padding: 1rem 0 4rem;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.2rem;
      }

      h2 {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 3rem);
        letter-spacing: -0.04em;
      }

      .section-copy {
        color: var(--muted);
        max-width: 62ch;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.2rem;
      }

      .card {
        background: rgba(255,255,255,0.025);
        border: 1px solid var(--panel-border);
        border-radius: 22px;
        padding: 1.4rem;
      }

      .card h3 {
        margin: 0.4rem 0 0.65rem;
        font-size: 1.2rem;
      }

      .card p {
        margin: 0;
        color: var(--muted);
      }

      .badge {
        display: inline-flex;
        padding: 0.35rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        background: rgba(104, 211, 145, 0.12);
        color: var(--green);
        border: 1px solid rgba(104, 211, 145, 0.2);
      }

      .cta-wrap {
        padding: 2.2rem 0 4.5rem;
      }

      .cta-box {
        background: linear-gradient(135deg, rgba(217,181,109,0.12), rgba(15,23,42,0.9));
        border: 1px solid rgba(217,181,109,0.25);
        border-radius: 28px;
        padding: clamp(1.5rem, 3vw, 2.4rem);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      footer {
        border-top: 1px solid var(--panel-border);
        padding: 1.2rem 0 3rem;
        color: var(--muted);
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      @media (max-width: 820px) {
        .hero-grid,
        .cards {
          grid-template-columns: 1fr;
        }

        .topbar-inner,
        .section-head,
        .cta-box,
        .footer-row {
          align-items: flex-start;
          flex-direction: column;
        }

        .nav {
          gap: 0.8rem;
        }
      }
    </style>
