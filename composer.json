{
    "name": "esthetics-hub/bio-sync-core",
    "description": "Backend engine for The Esthetics Hub - Biohacking & Metabolic Health Platform",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "google/apiclient": "^2.15",
        "resend/resend-php": "^0.10.0",
        "starkbank/ecdsa": "^2.0",
        "google/cloud-functions-framework": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "fakerphp/faker": "^1.23",
        "symfony/var-dumper": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Database\\": "database/",
            "App\\Payments\\": "src/Payments/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "start": "php -S 0.0.0.0:${PORT:-8080} vendor/google/cloud-functions-framework/router.php"
    }
}
