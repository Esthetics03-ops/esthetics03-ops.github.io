# --- Security & Credentials (CRITICAL) ---
# Never commit these; they grant access to your Google/Cloud accounts.
credentials.json
token.json
client_secret.json
.env
.env.local
.env.*.local

# --- Databases (SQLite & Local Storage) ---
# Prevent your local DB or backups from bloating the repo.
*.db
*.sqlite
*.sqlite3
/data/

# --- Python Environment & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# --- Build & Distribution ---
# If you eventually package your scripts
dist/
build/
*.egg-info/
.installed.cfg
*.egg

# --- Logs & Performance Tracking ---
*.log
# Specific log files for syncing
google_sync_error.log
analytics_fetch.log

# --- Local OS & IDE Specifics ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Temporary & Scratch Files ---
temp/
tmp/
*.bak

# Google Ads API Credentials - Bio-Sync Master v18.5
# --------------------------------------------------

# Developer token from your Google Ads Manager API Center (Status: Requested)
developer_token: "DEVELOPER_TOKEN_FROM_ADS_CENTER"

# OAuth 2.0 Credentials (from Google Cloud Console)
client_id: "782440185579889306379-apps.googleusercontent.com"
client_secret: "GOCSPX-CLIENT_SECRET_FROM_CONSOLE"

# Your long-lived Refresh Token (Generated via OAuth Playground)
refresh_token: "1//0_REFRESH_TOKEN_GENERATED_BY_OAUTH"

# Your 10-digit Customer ID for 'The Esthetics Hub' (No dashes)
login_customer_id: "CUSTOMER_ID_FROM_ADS_DASHBOARD"

# Use Proto Plus for better performance in Python
use_proto_plus: True
