{
  "name": "esthetics-api",
  "version": "1.0.0",
  "description": "Esthetics API server with optimization and campaign management",
  "main": "server.js",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "fix-ads": "node fix-campaign.js",
    "optimize": "node optimize.js",
    "deploy": "npm run optimize && git add . && git commit -m 'Optimize build and patch performance indicators' && git push origin main",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@lhci/cli": "^0.15.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "api",
    "express",
    "esthetics",
    "cors",
    "optimization"
  ],
  "author": "Esthetics03-ops",
  "license": "MIT"
}
