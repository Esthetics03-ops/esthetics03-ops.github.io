# ==============================================================================
# THE ESTHETICS HUB - BIO-SYNC CORE CONFIGURATION
# ==============================================================================

# --- Application Core ---
APP_NAME="The Esthetics Hub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://esthetics03-ops.github.io
TIMEZONE=Africa/Nairobi

# --- Safaricom Lipa Na M-PESA (Daraja API) ---
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=your_mpesa_key_here
MPESA_CONSUMER_SECRET=your_mpesa_secret_here
MPESA_SHORTCODE=your_paybill_or_till_number
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://your-api-endpoint.com/v1/mpesa/callback

# --- Google Cloud & Analytics (GA4/Search Console) ---
GCP_PROJECT_ID=esthetics-tracker-project
GOOGLE_APPLICATION_CREDENTIALS=auth/credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
GA4_PROPERTY_ID=your_ga4_property_id
GS_SEARCH_CONSOLE_SITE_URL=https://esthetics03-ops.github.io

# --- Google Sheets & Data Archival ---
# Main Bio-Sync Master Hub Sheet
SHEET_ID=1abc123XYZ...
# Target Sheet for Sunday Archival Backups
ARCHIVE_SHEET_ID=your_archive_id_here
RAW_DATA_TAB_NAME="RawData"

# --- Messaging & Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_admin_chat_id

# --- Administrative ---
ADMIN_EMAIL=esthetics03@gmail.com
SYSTEM_NOTIFICATION_EMAIL=notifications@esthetics03.com

# --- Database ---
# For the SQLite local store
DB_CONNECTION=sqlite
DB_DATABASE=database/hub_storage.sqlite
